NINE_ROUTER_PORT=20128

# Generate unique, long random values for these secrets.
JWT_SECRET=replace-with-a-long-random-secret
INITIAL_PASSWORD=replace-with-a-strong-initial-password
API_KEY_SECRET=replace-with-a-different-long-random-secret
MACHINE_ID_SALT=replace-with-another-long-random-secret

# After setting up 9Router, enter the endpoint API key created in its dashboard.
NINE_ROUTER_API_KEY=replace-with-9router-endpoint-api-key

# Set true when the dashboard is served through an HTTPS domain.
AUTH_COOKIE_SECURE=false